#!/bin/sh
# ==============================================================================
# 作者: ainigost
# 创建时间: 2026-09-23
# 功能简述: 动态解析并批量放行 IPv4 和 IPv6 外部访问路由器自身(INPUT链)的端口及区间
# ==============================================================================

# ----------------------------- 变量配置区 -----------------------------
# 需要放行的 IPv4 端口或区间 (多个使用英文逗号分隔，区间使用短横线)
IPV4_PORT="8443,4200"

# 需要放行的 IPv6 端口或区间 (多个使用英文逗号分隔，区间使用短横线)
IPV6_PORT="8443,4200"
# ----------------------------------------------------------------------

# 放行 IPv4 端口逻辑
if [ -n "$IPV4_PORT" ]; then
    # 将逗号替换为空格进行遍历拆分
    for port in $(echo "$IPV4_PORT" | tr ',' ' '); do
        # 适配 iptables 的语法格式，将短横线转换为冒号以表示端口范围
        formatted_port=$(echo "$port" | tr '-' ':')
        
        # 插入 TCP 和 UDP 允许规则至 INPUT 链首位
        iptables -I INPUT -p tcp --dport "$formatted_port" -j ACCEPT
        iptables -I INPUT -p udp --dport "$formatted_port" -j ACCEPT
    done
fi

# 放行 IPv6 端口逻辑
if [ -n "$IPV6_PORT" ]; then
    for port in $(echo "$IPV6_PORT" | tr ',' ' '); do
        formatted_port=$(echo "$port" | tr '-' ':')
        
        ip6tables -I INPUT -p tcp --dport "$formatted_port" -j ACCEPT
        ip6tables -I INPUT -p udp --dport "$formatted_port" -j ACCEPT
    done
fi
