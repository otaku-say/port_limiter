#!/bin/sh
# 作者: ainigost
# 创建时间: 2026-09-24
# 功能简述: 双通道后台看门狗守护，确保 Web 后台与终端的 IPv6 中继服务持续稳定运行

# 结束历史残留进程
killall socat 2>/dev/null

# 启动 Web 后台中继守护 (IPv6:8443 -> IPv4:8443)
(
    while true; do
        socat TCP6-LISTEN:8443,reuseaddr,fork TCP4:192.168.50.1:8443 >/dev/null 2>&1
        sleep 2
    done
) &

# 启动 Web Shell 终端中继守护 (IPv6:4200 -> IPv4:4200)
(
    while true; do
        socat TCP6-LISTEN:4200,reuseaddr,fork TCP4:192.168.50.1:4200 >/dev/null 2>&1
        sleep 2
    done
) &
