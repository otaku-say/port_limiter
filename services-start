#!/bin/sh
# ==============================================================================
# 作者: ainigost
# 创建时间: 2026-09-24
# 功能简述: 启动 IPv6 4200 端口转发常驻进程，彻底脱钩终端会话并注册定时巡检
# ==============================================================================

# 导入必要路径
export PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin:$PATH

# 1. 清理历史残留进程
killall socat 2>/dev/null
killall socat-watchdog.sh 2>/dev/null

# 2. 写入独立的看门狗脚本，注入 trap 强制忽略挂断与终端信号
cat << 'DOG' > /tmp/socat-watchdog.sh
#!/bin/sh
# 核心关键: 忽略终端挂断 (SIGHUP) 及常用中断信号，保证 SSH 退出后绝不被连带杀死
trap '' HUP INT QUIT TERM

while true; do
    if ! pidof socat >/dev/null 2>&1; then
        /opt/bin/socat TCP6-LISTEN:4200,reuseaddr,fork,ipv6only TCP4:127.0.0.1:4200
    fi
    sleep 2
done
DOG
chmod +x /tmp/socat-watchdog.sh

# 3. 使用 setsid 创建全新会话，并彻底断开输入输出（</dev/null），实现完全守护进程化
if which setsid >/dev/null 2>&1; then
    setsid /tmp/socat-watchdog.sh </dev/null >/dev/null 2>&1 &
else
    nohup /tmp/socat-watchdog.sh </dev/null >/dev/null 2>&1 &
fi

# 4. 定时任务双重兜底 (每 2 分钟巡检一次)
cru a SocatWatchdog "*/2 * * * * /bin/sh -c 'pidof socat >/dev/null || (/tmp/socat-watchdog.sh </dev/null >/dev/null 2>&1 &)'"
