#!/bin/sh
# ==============================================================================
# 作者: ainigost
# 创建时间: 2026-09-23
# 功能简述: 动态解析放行 IPv4/IPv6 端口；增加去重逻辑与稳定的 socat 隧道保护
# ==============================================================================

# ----------------------------- 变量配置区 -----------------------------
# IPv4 放行配置 (支持单端口、多端口逗号分隔、端口区间短横线连接)
IPV4_PORT_TCP="8443,4200"
IPV4_PORT_UDP=""

# IPv6 放行配置 (支持单端口、多端口逗号分隔、端口区间短横线连接)
IPV6_PORT_TCP="8443,4200"
IPV6_PORT_UDP=""

# IPv6 到 IPv4 的端口转发隧道 (针对缺乏原生 IPv6 监听的本地服务)
# 填写需要代理的端口号，多个用逗号分隔，留空则不启用该协议的隧道
SOCAT_TCP6_TO_IPV4="8443,4200"
SOCAT_UDP6_TO_IPV4=""
# ----------------------------------------------------------------------

apply_rules() {
    local ip_version="$1"
    local protocol="$2"
    local ports="$3"
    
    [ -z "$ports" ] && return
    
    local cmd="iptables"
    [ "$ip_version" = "6" ] && cmd="ip6tables"
    
    for port in $(echo "$ports" | tr ',' ' '); do
        local formatted_port=$(echo "$port" | tr '-' ':')
        
        # 核心优化：先尝试静默删除旧规则，防止重复触发时规则无限堆叠
        $cmd -D INPUT -p "$protocol" --dport "$formatted_port" -j ACCEPT 2>/dev/null
        
        # 再插入新规则到首位
        $cmd -I INPUT -p "$protocol" --dport "$formatted_port" -j ACCEPT
    done
}

apply_rules "4" "tcp" "$IPV4_PORT_TCP"
apply_rules "4" "udp" "$IPV4_PORT_UDP"
apply_rules "6" "tcp" "$IPV6_PORT_TCP"
apply_rules "6" "udp" "$IPV6_PORT_UDP"

# ----------------------------------------------------------------------
# 隧道保活修复逻辑
# 杀掉旧隧道后，强制等待 1 秒钟让内核完全释放端口，再使用 nohup 脱离父进程绑定运行
killall socat 2>/dev/null
sleep 1

if [ -n "$SOCAT_TCP6_TO_IPV4" ]; then
    for tunnel_port in $(echo "$SOCAT_TCP6_TO_IPV4" | tr ',' ' '); do
        nohup socat TCP6-LISTEN:"$tunnel_port",ipv6only=1,reuseaddr,fork TCP4:127.0.0.1:"$tunnel_port" >/dev/null 2>&1 &
    done
fi

if [ -n "$SOCAT_UDP6_TO_IPV4" ]; then
    for tunnel_port in $(echo "$SOCAT_UDP6_TO_IPV4" | tr ',' ' '); do
        nohup socat UDP6-LISTEN:"$tunnel_port",ipv6only=1,reuseaddr,fork UDP4:127.0.0.1:"$tunnel_port" >/dev/null 2>&1 &
    done
fi
