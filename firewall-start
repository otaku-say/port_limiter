#!/bin/sh
# ==============================================================================
# 作者: ainigost
# 创建时间: 2026-09-23
# 功能简述: 动态解析并批量放行 IPv4/IPv6 端口；包含规则去重逻辑，防止重拨号导致规则堆叠
# ==============================================================================

# ----------------------------- 变量配置区 -----------------------------

# 【IPv4 TCP 端口放行】
# 允许外部网络通过 IPv4 访问路由器自身的 TCP 端口。
# 填写示例：
#   单端口放行: "80"
#   多端口放行: "80,443,8443" (使用英文逗号分隔)
#   端口段放行: "40000-50000" (使用短横线连接)
#   混合式配置: "80,443,40000-50000"
#   不放行留空: ""
IPV4_PORT_TCP="8443,4200"

# 【IPv4 UDP 端口放行】
# 允许外部网络通过 IPv4 访问路由器自身的 UDP 端口。
# 填写示例规则同上。
IPV4_PORT_UDP=""

# 【IPv6 TCP 端口放行】
# 允许外部网络通过 IPv6 访问路由器自身的 TCP 端口。
# 填写示例: "8443,4200,10000-20000"
IPV6_PORT_TCP="8443,4200"

# 【IPv6 UDP 端口放行】
# 允许外部网络通过 IPv6 访问路由器自身的 UDP 端口。
# 填写示例: "10000-20000"
IPV6_PORT_UDP=""

# ----------------------------------------------------------------------

# 统一处理端口放行逻辑
apply_rules() {
    local ip_version="$1"
    local protocol="$2"
    local ports="$3"
    
    # 如果变量为空，则直接跳过不执行
    if [ -z "$ports" ]; then
        return
    fi
    
    # 根据传入的 IP 版本选择相应的内核防火墙命令
    local cmd="iptables"
    if [ "$ip_version" = "6" ]; then
        cmd="ip6tables"
    fi
    
    # 遍历处理以逗号分隔的每一个端口或端口段
    for port in $(echo "$ports" | tr ',' ' '); do
        # 转换我们易读的短横线("-")为底层 iptables 能识别的冒号(":")区间格式
        local formatted_port=$(echo "$port" | tr '-' ':')
        
        # 核心防堆叠逻辑：
        # 先尝试静默删除旧规则 (2>/dev/null 屏蔽报错)，防止网络波动重复触发脚本导致规则无限堆叠
        $cmd -D INPUT -p "$protocol" --dport "$formatted_port" -j ACCEPT 2>/dev/null
        
        # 然后将新规则插入到入站 (INPUT) 链的最高优先级首位
        $cmd -I INPUT -p "$protocol" --dport "$formatted_port" -j ACCEPT
    done
}

# 依次执行各维度规则的下发
apply_rules "4" "tcp" "$IPV4_PORT_TCP"
apply_rules "4" "udp" "$IPV4_PORT_UDP"
apply_rules "6" "tcp" "$IPV6_PORT_TCP"
apply_rules "6" "udp" "$IPV6_PORT_UDP"
